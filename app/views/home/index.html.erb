<section class="wrapper py-12 md:py-16 lg:py-20">
  <div class="space-y-4 mb-8">
    <h1 class="text-3xl md:text-4xl font-serif font-semibold text-black">High-performance laptops for professionals.</h1>
    <p class="text-base md:text-lg text-gray-700 max-w-2xl">Discover configurable systems with powerful specs. Compare, customize, and find your perfect build.</p>
  </div>
  
  <div class="flex flex-col gap-2 sm:flex-row">
    <%= render "shared/call_to_action", { label: "Shop collection", url: products_path, type: 'primary' } %>
    <%= render "shared/call_to_action", { label: "Browse all", url: products_path, type: 'secondary' } %>
  </div>
</section>

<%= render 'featured_products', { products: @featured_products } if @featured_products.try(:any?) %>
<%= render 'collection', { title: "Shop Collection", products: @collection_products } if @collection_products.try(:any?) %>
<%= render 'collections_with_call_to_action', { products: @cta_collection_products[0..1] } if @cta_collection_products.try(:any?) %>
<%= render 'featured_product_banner', { product: @cta_collection_products[2] } if @cta_collection_products && @cta_collection_products.size > 2 %>
<%= render 'collection', { title: "New Arrivals", products: @new_arrivals } if @new_arrivals.try(:any?) %>
