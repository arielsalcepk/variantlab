<% if products.present? %>
  <section class="wrapper py-8 lg:py-12">
    <div class="grid gap-6 xl:grid-cols-[1.2fr_1fr]">
      <div class="rounded-3xl bg-slate-950 p-8 text-white shadow-2xl lg:p-12 flex flex-col justify-between">
        <div class="space-y-4">
          <span class="text-xs uppercase tracking-[0.3em] text-slate-400">Featured collection</span>
          <h2 class="text-3xl font-serif tracking-tight sm:text-4xl">Become the brand everyone talks about.</h2>
          <p class="max-w-xl text-sm leading-7 text-slate-300">Shop curated looks, discover fresh arrivals, and find pieces that feel premium from the first wear.</p>
        </div>

        <div class="mt-8">
          <%= render "shared/call_to_action", { label: "Get started", url: 'https://solidus.io/get-started', target: '_blank' } %>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <% products.each do |product| %>
          <%= cache [I18n.locale, current_pricing_options, @taxon, product] do %>
            <%= link_to product_path(product), class: "group block rounded-2xl overflow-hidden bg-slate-100 shadow-lg transition hover:-translate-y-1" do %>
              <div class="relative aspect-[4/5] bg-slate-200">
                <% product_image = product.gallery.images.second || product.gallery.images.first %>
                <%= render(ImageComponent.new(
                  image: product_image,
                  class: 'w-full h-full object-cover',
                  size: :full,
                )) %>
              </div>
              <div class="space-y-2 p-4">
                <p class="text-sm font-semibold text-slate-950"><%= product.name %></p>
                <p class="text-base font-medium text-slate-600"><%= product.display_price %></p>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>